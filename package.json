{
  "name": "sanguo-dev-calendar",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "change": "bun changeset",
    "version": "bun changeset version",
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run --fail-if-no-match doc#dev",
    "prepare": "vp config",
    "test": "vp test",
    "coverage": "vp run -r coverage",
    "bench": "vp run bench:local",
    "bench:local": "vp run -F @sanguo-dev/bench bench:local",
    "bench:npm": "vp run -F @sanguo-dev/bench bench:npm",
    "bench:report": "vp run -F @sanguo-dev/bench bench:report"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.6",
    "vitest": "5.1.0",
    "@vitest/coverage-v8": "5.1.0"
  }
}
